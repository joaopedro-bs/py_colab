## 5. Pré-processamento
# Filtrar por limiar de rating
df_liked = df_ratings[df_ratings["rating"] >= RATING_THRESHOLD].copy()

print(f"Avaliações totais:          {len(df_ratings):>10,}")
print(f"Avaliações com rating ≥ {RATING_THRESHOLD}:   {len(df_liked):>10,}")
print(f"Percentual mantido:         {len(df_liked)/len(df_ratings):.2%}")
print(f"Usuários com ≥ 1 filme apreciado: {df_liked['user_id'].nunique():,}")
print(f"Filmes apreciados por ≥ 1 usuário: {df_liked['movie_id'].nunique():,}")
# Juntar com títulos dos filmes
df_liked = df_liked.merge(df_movies[["movie_id", "title"]], on="movie_id")

# Construir lista de transações: cada usuário = uma transação, itens = filmes apreciados
transactions = (
    df_liked.groupby("user_id")["title"]
    .apply(list)
    .tolist()
)

# Estatísticas das transações
trans_lengths = [len(t) for t in transactions]
print(f"Nº de transações (usuários): {len(transactions):,}")
print(f"Itens por transação — min: {min(trans_lengths)}, mediana: {int(np.median(trans_lengths))}, max: {max(trans_lengths)}")
print(f"Média de filmes por usuário: {np.mean(trans_lengths):.1f}")
# Construção das transações para efficient-apriori
# efficient-apriori trabalha diretamente com lista de tuplas —
# NÃO precisa de matriz binária densa, o que elimina o gargalo de performance
# do mlxtend com 3.500+ itens.

transactions_tuples = [
    tuple(filmes) for filmes in
    df_liked.groupby("user_id")["title"].apply(list).tolist()
]

# Estatísticas
trans_lengths = [len(t) for t in transactions_tuples]
print(f"Nº de transações: {len(transactions_tuples):,}")
print(f"Itens por transação — min: {min(trans_lengths)}, mediana: {int(np.median(trans_lengths))}, max: {max(trans_lengths)}")
print(f"Formato: lista de tuplas — pronto para efficient-apriori")

# Manter também TransactionEncoder para eventuais análises matriciais na EDA
te = TransactionEncoder()
te_array = te.fit(transactions_tuples).transform(transactions_tuples)
df_bin = pd.DataFrame(te_array, columns=te.columns_).astype(pd.SparseDtype('bool', False))
print(f"Matriz binária esparsa: {df_bin.shape} | {df_bin.memory_usage(deep=True).sum()/1024**2:.1f} MB")

**Decisões de pré-processamento:**
1. **Limiar ≥ 4**: Mantém apenas filmes genuinamente apreciados, reduzindo ruído.
2. **Formato transacional**: Cada usuário é uma "cesta", os filmes são os "itens" — paradigma clássico de market basket analysis (Han et al., Cap. 6).
3. **Identificação por título**: Usamos o título do filme (em vez do ID) para facilitar a interpretação das regras.
## 6. Modelagem — Mineração de Regras de Associação
### 6.1 Justificativa dos Hiperparâmetros e Escolha dos Algoritmos

Com base na EDA:
- **Esparsidade ~95%**: suportes muito baixos geram regras triviais; muito altos capturam apenas blockbusters.
- **Mediana de ~58 filmes por usuário**: suporte 5% = filme em ≥302 usuários — captura padrões além do mainstream.
- **3.533 itens únicos**: algoritmos que constroem matrizes binárias densas (mlxtend FP-Growth) tornam-se inviáveis nessa escala.

**Algoritmos escolhidos:**

| Algoritmo | Biblioteca | Formato de entrada | Complexidade |
|---|---|---|---|
| **Apriori** | `efficient-apriori` | Lista de tuplas | O(2^n) candidatos |
| **FP-Growth** | `pyfpgrowth` | Lista de listas | O(n·\|FP-tree\|) |

- **Apriori** (Agrawal & Srikant, 1994): gera candidatos iterativamente, poda itemsets infrequentes. Referência clássica da literatura.
- **FP-Growth** (Han et al., 2000): constrói uma árvore compacta (FP-tree) e minera sem geração de candidatos — mais eficiente em datasets esparsos com muitos itens (Han et al., Cap. 6, Seção 6.2.4).

**Hiperparâmetros finais:** `min_support = 5%`, `min_confidence = 30%`, `min_lift ≥ 1.0`, `max_length = 3`.
import time

# ── Configuração de hiperparâmetros ────────────────────────────────────
MIN_SUPPORT    = 0.05   # 5% dos usuários (≥302 usuários)
MIN_CONFIDENCE = 0.30   # 30%
MIN_LIFT       = 1.0
MAX_LENGTH     = 3      # itemsets de até 3 filmes

print("=== 6.2 Apriori (efficient-apriori) ===")
print(f"  min_support    = {MIN_SUPPORT:.0%} (≥{int(MIN_SUPPORT*len(transactions_tuples))} usuários)")
print(f"  min_confidence = {MIN_CONFIDENCE:.0%}")
print(f"  min_lift       = {MIN_LIFT}")
print(f"  max_length     = {MAX_LENGTH}")

# Mineração com Apriori
# efficient-apriori opera sobre lista de tuplas sem conversão para matriz binária —
# isso contorna o gargalo do mlxtend com 3.500+ itens (bottleneck em fpcommon.py)
t0 = time.time()
itemsets_raw, rules_raw = run_apriori(
    transactions_tuples,
    min_support=MIN_SUPPORT,
    min_confidence=MIN_CONFIDENCE,
    max_length=MAX_LENGTH,
)
t_apriori = time.time() - t0

# Converter para DataFrame padronizado (frozenset para compatibilidade)
records_apriori = []
for rule in rules_raw:
    if rule.lift >= MIN_LIFT:
        records_apriori.append({
            "antecedents": frozenset(rule.lhs),
            "consequents": frozenset(rule.rhs),
            "support":    round(rule.support, 6),
            "confidence": round(rule.confidence, 6),
            "lift":       round(rule.lift, 6),
        })

rules_apriori = (pd.DataFrame(records_apriori)
                 .sort_values("lift", ascending=False)
                 .reset_index(drop=True))

n_itemsets = sum(len(v) for v in itemsets_raw.values())
print(f"\n  Tempo Apriori:          {t_apriori:.1f}s")
print(f"  Itemsets frequentes:    {n_itemsets:,}")
print(f"  Regras (lift≥{MIN_LIFT}):   {len(rules_apriori):,}")
print(f"  Lift médio:             {rules_apriori['lift'].mean():.4f}")
print(f"  Lift máximo:            {rules_apriori['lift'].max():.4f}")

# Estatísticas das regras encontradas (Apriori)
print(f"Total de regras com lift ≥ {MIN_LIFT}: {len(rules_apriori):,}")
print(f"\nEstatísticas de lift:")
print(rules_apriori['lift'].describe().round(4))
print(f"\nEstatísticas de confidence:")
print(rules_apriori['confidence'].describe().round(4))
print(f"\nEstatísticas de support:")
print(rules_apriori['support'].describe().round(4))

### 6.2 Top-20 Regras — Apriori
# Top-20 regras por lift — Apriori
def fmt_frozen(fs):
    return ", ".join(sorted(str(x) for x in fs))

rules_apriori_disp = rules_apriori.copy()
rules_apriori_disp["antecedent"] = rules_apriori["antecedents"].apply(fmt_frozen)
rules_apriori_disp["consequent"] = rules_apriori["consequents"].apply(fmt_frozen)

display_cols = ["antecedent", "consequent", "support", "confidence", "lift"]
print("Top-20 regras por lift (Apriori):")
print(
    rules_apriori_disp[display_cols]
    .head(20)
    .to_string(index=False, float_format="{:.4f}".format)
)

### 6.3 FP-Growth (`pyfpgrowth`)

O FP-Growth constrói uma estrutura compacta chamada **FP-tree** e extrai padrões frequentes sem gerar candidatos explicitamente. A biblioteca `pyfpgrowth` é uma implementação nativa em C que opera diretamente sobre listas de transações, contornando o gargalo de memória de matrizes binárias densas (Han et al., Cap. 6, Seção 6.2.4).
# ── FP-Growth com pyfpgrowth ──────────────────────────────────────────
MIN_SUP_ABS = int(MIN_SUPPORT * len(transactions_tuples))

print(f"=== 6.3 FP-Growth (pyfpgrowth) ===")
print(f"  min_support_abs = {MIN_SUP_ABS} usuários ({MIN_SUPPORT:.0%})")
print(f"  min_confidence  = {MIN_CONFIDENCE:.0%}")

t0 = time.time()
fp_patterns = pyfpgrowth.find_frequent_patterns(
    [list(t) for t in transactions_tuples],
    MIN_SUP_ABS
)
t_fp_patterns = time.time() - t0
print(f"  Padrões frequentes: {len(fp_patterns):,} em {t_fp_patterns:.1f}s")

t1 = time.time()
fp_rules_raw = pyfpgrowth.generate_association_rules(fp_patterns, MIN_CONFIDENCE)
t_fp_rules_time = time.time() - t1
print(f"  Regras brutas (conf≥{MIN_CONFIDENCE:.0%}): {len(fp_rules_raw):,} em {t_fp_rules_time:.1f}s")

# Pré-calcular suportes individuais UMA VEZ para evitar loop O(n) por regra
# Usar fp_patterns; para itens não-frequentes, calcular via set comprehension em lote
n_transactions = len(transactions_tuples)

# Coletar todos os consequentes que não estão nos padrões
all_rhs = set()
for lhs, (rhs, conf) in fp_rules_raw.items():
    rhs_key = rhs if isinstance(rhs, tuple) else (rhs,)
    if rhs_key not in fp_patterns:
        all_rhs.add(rhs_key)

# Calcular suportes ausentes em lote
missing_sup = {}
if all_rhs:
    trans_sets = [set(t) for t in transactions_tuples]  # uma vez só
    for rhs_key in all_rhs:
        rhs_set = set(rhs_key)
        missing_sup[rhs_key] = sum(1 for ts in trans_sets if rhs_set.issubset(ts))

# Montar DataFrame
records_fp = []
for lhs, (rhs, conf) in fp_rules_raw.items():
    lhs_key = lhs if isinstance(lhs, tuple) else (lhs,)
    rhs_key = rhs if isinstance(rhs, tuple) else (rhs,)

    sup_rhs_count = fp_patterns.get(rhs_key, missing_sup.get(rhs_key, 0))
    sup_rhs = sup_rhs_count / n_transactions
    if sup_rhs == 0:
        continue

    lift_val = conf / sup_rhs
    if lift_val < MIN_LIFT:
        continue

    union_key = tuple(sorted(set(lhs_key) | set(rhs_key)))
    sup_lr_count = fp_patterns.get(union_key, 0)
    sup_rule = sup_lr_count / n_transactions

    records_fp.append({
        "antecedents": frozenset(lhs_key),
        "consequents": frozenset(rhs_key),
        "support":    round(sup_rule, 6),
        "confidence": round(conf, 6),
        "lift":       round(lift_val, 6),
    })

t_fp_total = time.time() - t0
rules_fp = (pd.DataFrame(records_fp)
            .sort_values("lift", ascending=False)
            .reset_index(drop=True))

print(f"\n  Regras (lift≥{MIN_LIFT}): {len(rules_fp):,}")
if len(rules_fp):
    print(f"  Lift médio:            {rules_fp['lift'].mean():.4f}")
    print(f"  Lift máximo:           {rules_fp['lift'].max():.4f}")
print(f"  Tempo total FP-Growth: {t_fp_total:.1f}s")

### Top-20 Regras — FP-Growth
rules_fp_disp = rules_fp.copy()
rules_fp_disp["antecedent"] = rules_fp["antecedents"].apply(fmt_frozen)
rules_fp_disp["consequent"] = rules_fp["consequents"].apply(fmt_frozen)

print("Top-20 regras por lift (FP-Growth):")
print(
    rules_fp_disp[display_cols]
    .head(20)
    .to_string(index=False, float_format="{:.4f}".format)
)

### 6.4 Comparação Apriori × FP-Growth

Ambos os algoritmos são **matematicamente equivalentes**: produzem o mesmo conjunto de itemsets frequentes dado o mesmo `min_support`. A diferença está na estratégia de busca — Apriori gera candidatos explicitamente (bottom-up), FP-Growth comprime as transações em uma FP-tree e minera por projeção (Han et al., Cap. 6). Espera-se que o FP-Growth seja mais rápido em datasets esparsos com muitos itens, pois evita a explosão de candidatos.
# ── Tabela comparativa ────────────────────────────────────────────────
# Usar as variáveis de tempo já registradas (t_apriori, t_fp_total)
df_comparison = pd.DataFrame({
    "Algoritmo":        ["Apriori (efficient-apriori)", "FP-Growth (pyfpgrowth)"],
    "Nº Regras":        [len(rules_apriori), len(rules_fp)],
    "Lift Médio":       [round(rules_apriori['lift'].mean(), 4),
                         round(rules_fp['lift'].mean(), 4)],
    "Lift Máximo":      [round(rules_apriori['lift'].max(), 4),
                         round(rules_fp['lift'].max(), 4)],
    "Conf. Média":      [round(rules_apriori['confidence'].mean(), 4),
                         round(rules_fp['confidence'].mean(), 4)],
    "Tempo (s)":        [round(t_apriori, 1), round(t_fp_total, 1)],
})

print("=== Comparação Apriori × FP-Growth ===")
print(df_comparison.to_string(index=False))

# Diferença percentual de tempo
speedup = t_apriori / t_fp_total if t_fp_total > 0 else float('inf')
print(f"\nSpeedup FP-Growth vs Apriori: {speedup:.1f}x")
print("\nObservação: diferenças em 'Nº Regras' refletem regras simétricas")
